# All variables are optional. They are embedded in the static build – never put secrets here.

# OpenMapTiles-compatible vector tiles (TileJSON) and label glyphs.
# VITE_MAP_TILEJSON_URL=https://tiles.openfreemap.org/planet
# VITE_MAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf

# Nominatim instance for place search, and a contact e-mail as its usage policy recommends.
# VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
# VITE_NOMINATIM_EMAIL=you@example.com
